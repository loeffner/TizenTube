# Copy to lan.env (not committed) and adjust.

# Where the TV loads the userscript from. Required.
TT_USERSCRIPT_URL=https://tizentube.example.lan/userScript.js

# CA certificates the TV trusts for that URL (PEM bundle). The default covers
# Let's Encrypt. Empty: use Node's built-in list, which on old TVs is from 2016.
#TT_CA_FILE=lan/isrg-roots.pem

# Tizen package id (10 letters/digits) and the name on the TV. Changing the id
# installs a separate app.
#TT_PACKAGE_ID=lanTizTub1
#TT_APP_NAME="TizenTube LAN"
